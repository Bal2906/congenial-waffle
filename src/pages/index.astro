---
import ExtractorApp from '../components/ExtractorApp.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Extractor de Preguntas de Simuladores | Quiz Scanner</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Navbar Header -->
		<header class="app-header">
			<div class="container header-content">
				<div class="brand">
					<div class="brand-icon">Q</div>
					<div>
						<span>QuizScanner</span>
						<span style="font-weight: 400; font-size: 0.85rem; color: var(--text-muted); margin-left: 0.4rem;">
							Extractor Frontend
						</span>
					</div>
				</div>
				
				<div style="display: flex; align-items: center; gap: 0.75rem;">
					<span class="badge-tag">Versión 1.0</span>
				</div>
			</div>
		</header>

		<!-- Main Content Area -->
		<main class="container">
			<div style="margin-bottom: 2rem; text-align: center;">
				<h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem; letter-spacing: -0.02em;">
					Extractor de Preguntas y Respuestas
				</h1>
				<p style="color: var(--text-muted); font-size: 1rem; max-width: 680px; margin: 0 auto; line-height: 1.6;">
					Carga tus archivos HTML del simulador (carpeta <code style="background: rgba(255,255,255,0.08); padding: 0.2rem 0.4rem; border-radius: 4px; color: #a5b4fc;">contexto</code>) para extraer solo la pregunta con su respuesta correcta verificada, inspeccionarla y exportarla.
				</p>
			</div>

			<ExtractorApp />
		</main>

		<!-- Footer -->
		<footer style="margin-top: auto; border-top: 1px solid var(--border-color); padding: 1.5rem 0; text-align: center; color: var(--text-dim); font-size: 0.85rem;">
			<div class="container">
				<p>Herramienta temporal de verificación de preguntas • Lista para migración a Base de Datos</p>
			</div>
		</footer>
	</body>
</html>
